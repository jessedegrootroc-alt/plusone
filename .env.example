# Kopieer naar .env.local en vul in vanuit Supabase: Project Settings > API (of Connect).
# De anon/publishable key is bedoeld voor in de app; Row Level Security beschermt de data.
# Zet hier NOOIT de service_role key.
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-key
